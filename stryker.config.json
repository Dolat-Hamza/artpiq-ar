{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx playwright test -c playwright.unit.config.ts"
  },
  "mutate": [
    "src/lib/embed/widgetParams.ts",
    "src/lib/embed/snippets.ts",
    "src/lib/image/loadImage.ts"
  ],
  "reporters": [
    "clear-text",
    "progress"
  ],
  "thresholds": {
    "high": 100,
    "low": 90,
    "break": 100
  },
  "concurrency": 2,
  "timeoutMS": 60000
}
